APP_ENV=development
APP_NAME=Instagram Automation
# META_APP_ID/META_APP_SECRET are the Instagram App ID/secret (Instagram >
# API setup with Instagram login). FACEBOOK_APP_ID/SECRET are from App
# settings > Basic and drive Facebook Pages, WhatsApp and the FB JS SDK.
# Leave blank to reuse the META_* values.
META_APP_ID=local_meta_app_id
META_APP_SECRET=local_meta_app_secret
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=local_verify_token_123
META_GRAPH_API_VERSION=v21.0
# When true, every outbound send on ALL THREE platforms (Instagram private
# replies and DMs, WhatsApp messages, Facebook private replies and DMs) is
# faked: the client returns success with a mock_* provider id and no HTTP
# request is made. Safe default for local work; you MUST set this to false to
# test against real Instagram/WhatsApp/Facebook accounts, or every message
# will silently not be delivered while the dashboard reports it as sent.
# docker-compose.yml deliberately does not set this -- it comes from here only.
META_MOCK_PRIVATE_REPLIES=true
# WhatsApp Cloud API Embedded Signup config_id, from Meta App dashboard >
# Business Settings > WhatsApp > Embedded Signup. Leave blank to disable the
# WhatsApp connect flow (its /whatsapp/connect/start endpoint 503s without it).
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Fail-closed global kill switch for business-initiated WhatsApp templates.
WHATSAPP_OUTREACH_ENABLED=false
WHATSAPP_OPT_IN_LINK_TTL_SECONDS=2592000
WHATSAPP_PUBLIC_OPT_IN_IP_LIMIT=10
WHATSAPP_PUBLIC_OPT_IN_ACCOUNT_LIMIT=100
WHATSAPP_PUBLIC_OPT_IN_WINDOW_SECONDS=3600
WHATSAPP_TEST_SEND_DAILY_LIMIT=20
WHATSAPP_RETRYABLE_META_CODES=
WHATSAPP_SEND_MAX_ATTEMPTS=5
WHATSAPP_DISPATCH_BATCH_SIZE=20
WHATSAPP_DISPATCH_MAX_BATCH_WINDOW_SECONDS=300
WHATSAPP_BROKER_VISIBILITY_TIMEOUT_SECONDS=3600
WHATSAPP_HEALTH_STALE_MINUTES=60
WHATSAPP_CAMPAIGN_BREAKER_WINDOW=20
WHATSAPP_CAMPAIGN_BREAKER_FAILURE_THRESHOLD=0.25
# Facebook Login for Business config_id — separate from WhatsApp's above,
# its own permission scopes (pages_show_list, pages_manage_metadata,
# pages_read_engagement, pages_manage_engagement, pages_messaging). Leave
# blank to disable the Facebook connect flow.
FACEBOOK_LOGIN_CONFIG_ID=
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
DASHBOARD_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/instagram_automation
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=instagram_automation

JWT_SECRET=change_me_local_jwt_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_SECRET_KEY=change_me_local_app_secret
TOKEN_ENCRYPTION_KEY=
