MERGE_PG15_USER=merge_dev
MERGE_PG15_PASSWORD=merge_dev_only_not_a_secret
MERGE_PG15_DB=many_throwaway
MERGE_PG15_PORT=55415

MERGE_PG17_USER=merge_dev
MERGE_PG17_PASSWORD=merge_dev_only_not_a_secret
