APP_ENV=production
APP_NAME=Instagram Automation
APP_BASE_URL=https://automation.yourdomain.com
FRONTEND_URL=https://automation.yourdomain.com
ALLOWED_ORIGINS=https://automation.yourdomain.com
DISABLE_DOCS=true
LOG_LEVEL=INFO
SENTRY_DSN=

DATABASE_URL=postgresql+psycopg://postgres:FILL_DB_PASSWORD@postgres:5432/instagram_automation
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=FILL_DB_PASSWORD
POSTGRES_DB=instagram_automation

JWT_SECRET=FILL_run: openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_SECRET_KEY=FILL_run: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=FILL_run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

META_APP_ID=FILL_from_Meta_dashboard
META_APP_SECRET=FILL_rotated_secret_from_Meta_dashboard
META_WEBHOOK_VERIFY_TOKEN=FILL_run: openssl rand -hex 32
META_GRAPH_API_VERSION=v21.0
META_MOCK_PRIVATE_REPLIES=false

NEXT_PUBLIC_API_URL=https://automation.yourdomain.com
NEXT_PUBLIC_APP_ENV=production

BACKUP_DIR=./backups
BACKUP_GPG_PASSPHRASE=