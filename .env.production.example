APP_ENV=production
APP_NAME=Instagram Automation
APP_BASE_URL=https://automation.yourdomain.com
DASHBOARD_BASE_URL=https://dashboard.yourdomain.com
FRONTEND_URL=https://automation.yourdomain.com
ALLOWED_ORIGINS=https://automation.yourdomain.com
DISABLE_DOCS=true
LOG_LEVEL=INFO
SENTRY_DSN=

DATABASE_URL=postgresql+psycopg://postgres:FILL_DB_PASSWORD@postgres:5432/instagram_automation
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=FILL_DB_PASSWORD
POSTGRES_DB=instagram_automation

JWT_SECRET=FILL_run: openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_SECRET_KEY=FILL_run: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=FILL_run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# META_APP_ID/META_APP_SECRET are the Instagram App ID/secret (Instagram >
# API setup with Instagram login). FACEBOOK_APP_ID/SECRET are from App
# settings > Basic and drive Facebook Pages, WhatsApp and the FB JS SDK.
# Leave blank to reuse the META_* values.
META_APP_ID=FILL_from_Meta_dashboard
META_APP_SECRET=FILL_rotated_secret_from_Meta_dashboard
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=FILL_run: openssl rand -hex 32
META_GRAPH_API_VERSION=v26.0
META_MOCK_PRIVATE_REPLIES=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_OUTREACH_ENABLED=false
WHATSAPP_OPT_IN_LINK_TTL_SECONDS=2592000
WHATSAPP_PUBLIC_OPT_IN_IP_LIMIT=10
WHATSAPP_PUBLIC_OPT_IN_ACCOUNT_LIMIT=100
WHATSAPP_PUBLIC_OPT_IN_WINDOW_SECONDS=3600
WHATSAPP_TEST_SEND_DAILY_LIMIT=20
WHATSAPP_RETRYABLE_META_CODES=
WHATSAPP_SEND_MAX_ATTEMPTS=5
WHATSAPP_DISPATCH_BATCH_SIZE=20
WHATSAPP_DISPATCH_MAX_BATCH_WINDOW_SECONDS=300
WHATSAPP_BROKER_VISIBILITY_TIMEOUT_SECONDS=3600
WHATSAPP_HEALTH_STALE_MINUTES=60
WHATSAPP_CAMPAIGN_BREAKER_WINDOW=20
WHATSAPP_CAMPAIGN_BREAKER_FAILURE_THRESHOLD=0.25
FACEBOOK_LOGIN_CONFIG_ID=

# Must be true behind nginx (the bundled nginx sets X-Forwarded-For / X-Real-IP).
# With false, every rate limit keys on the proxy's IP, so one noisy client
# throttles everybody. Only enable it when the backend is not directly reachable.
TRUST_PROXY_HEADERS=true

# AI replies. DM text and the account's business profile are sent to OpenAI.
# AI_ENABLED_GLOBAL is a kill switch on top of the per-account/campaign opt-ins.
# Leave OPENAI_API_KEY blank (and AI_ENABLED_GLOBAL=false) to run without AI.
OPENAI_API_KEY=
AI_ENABLED_GLOBAL=true
AI_MODEL_NAME=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_CONTEXT_TURNS=10

NEXT_PUBLIC_API_URL=https://automation.yourdomain.com
NEXT_PUBLIC_APP_ENV=production

BACKUP_DIR=./backups
BACKUP_GPG_PASSPHRASE=
