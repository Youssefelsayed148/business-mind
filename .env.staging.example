# Placeholders only. Copy to .env.unified ON THE STAGING HOST (git-ignored), fill in, chmod 600.
# It must be named .env.unified: the compose file passes that file to the containers (env_file) and
# the scripts pass it to compose for interpolation. Never commit real values. Used with:
#   docker compose -f docker-compose.unified.yml -f docker-compose.unified.prod.yml --env-file .env.unified ...
# Staging is production-shaped: same overlay, same versions, a Meta TEST number, no real customer data.
# --- compose interpolation (required) ---
MANY_DB_PASSWORD=CHANGE_ME
SAAS_DB_PASSWORD=CHANGE_ME
# --- hosts (real staging names; DNS A records point at the staging server) ---
MANY_HOST=many.staging.example.com
SAAS_WEB_HOST=app.staging.example.com
SAAS_API_HOST=api.staging.example.com
MANY_PUBLIC_URL=https://many.staging.example.com
PUBLIC_BASE_URL=https://app.staging.example.com
# --- TLS paths on the host (Phase 6A) ---
PKI_DIR=/opt/business-mind/pki
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot
# --- environment names (the prod overlay forces production behaviour) ---
MANY_APP_ENV=production
SAAS_ENVIRONMENT=production
COOKIE_SECURE=true
MANY_API_BASE_URL=https://many-api:8000
# --- Many app secrets: staging-only values, never the live ones ---
JWT_SECRET=CHANGE_ME
APP_SECRET_KEY=CHANGE_ME
TOKEN_ENCRYPTION_KEY=CHANGE_ME
META_APP_SECRET=CHANGE_ME_TEST_APP
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_NEW_FOR_STAGING
OPENAI_API_KEY=CHANGE_ME_STAGING_KEY_WITH_A_SPEND_LIMIT
# --- SaaS app secrets: staging-only values ---
CHANNEL_SECRET_ENCRYPTION_KEYS=CHANGE_ME
CHAT_OPENAI_API_KEY=CHANGE_ME_STAGING_KEY_WITH_A_SPEND_LIMIT
CHAT_OPENAI_MODEL=CHANGE_ME
# --- identity and data flags: ALL OFF until the Phase 3 review items are fixed or accepted (6G) ---
IDENTITY_V2_ENABLED=false
SSO_ISSUER_ENABLED=false
MANY_PROXY_ENABLED=false
SSO_ASSERTION_ENABLED=false
SSO_REQUIRE_MFA_FOR_ADMIN=false
MFA_ENFORCE_STAFF=false
MFA_ENFORCE_ADMINS=false
DATA_UNIFICATION_ENABLED=false
MAILER_BACKEND=console
