# Placeholders only. Copy to .env.unified (git-ignored) and fill in locally. Never commit real values.
# --- compose interpolation (required) ---
MANY_DB_PASSWORD=CHANGE_ME
SAAS_DB_PASSWORD=CHANGE_ME
# --- hosts (dev defaults; prod overlay: real domains) ---
MANY_HOST=localhost
SAAS_WEB_HOST=saas.localhost
SAAS_API_HOST=saas-api.localhost
UNIFIED_HTTP_PORT=8080
MANY_PUBLIC_URL=http://localhost:8080
MANY_APP_ENV=development
SAAS_ENVIRONMENT=development
COOKIE_SECURE=false
# --- Many app secrets (names only; CHANGE_ME placeholders) ---
JWT_SECRET=CHANGE_ME
APP_SECRET_KEY=CHANGE_ME
TOKEN_ENCRYPTION_KEY=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
# --- Identity and SSO (Phase 3). Every flag is OFF by default; names and placeholders only. ---
# Never commit real keys. Generate dev keys per docs/RUNBOOK-DEV.md.
IDENTITY_V2_ENABLED=false
SSO_ISSUER_ENABLED=false
SSO_ASSERTION_ENABLED=false
SSO_REQUIRE_MFA_FOR_ADMIN=false
MFA_ENFORCE_STAFF=false
MFA_ENFORCE_ADMINS=false
SSO_SIGNING_KID=CHANGE_ME
SSO_SIGNING_KEY_PEM=CHANGE_ME
SSO_PUBLIC_KEYS=CHANGE_ME
SSO_RETURN_ALLOWLIST=[]
MFA_SECRET_ENCRYPTION_KEYS=CHANGE_ME
PUBLIC_BASE_URL=http://localhost:3000
MAILER_BACKEND=console
# --- SaaS app secrets ---
CHANNEL_SECRET_ENCRYPTION_KEYS=CHANGE_ME
CHAT_OPENAI_API_KEY=CHANGE_ME
CHAT_OPENAI_MODEL=CHANGE_ME
